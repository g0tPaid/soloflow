<section class="pt-rule" style="padding: 80px 0;">
  <div class="pt-container">
    <p class="pt-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="pt-serif" style="margin: 12px 0 32px; font-size: 48px;">{{ section.settings.heading }}</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 28px;">
      {% if section.settings.products != blank %}
        {% for product in section.settings.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% assign related_collection = collections[section.settings.collection] %}
        {% if related_collection == blank and product.collections.size > 0 %}
          {% assign related_collection = product.collections.first %}
        {% endif %}
        {% if related_collection != blank %}
          {% for related_product in related_collection.products limit: section.settings.limit %}
            {% if related_product.id != product.id %}
              {% render 'product-card', product: related_product %}
            {% endif %}
          {% endfor %}
        {% else %}
          <p style="color: var(--pt-muted);">Choose related products or a collection in the theme editor.</p>
        {% endif %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Related products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Also consider"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Related products"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 4
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Fallback collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Related products"
    }
  ]
}
{% endschema %}
