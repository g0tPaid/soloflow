<section style="padding: 96px 0;">
  <div class="pt-container" style="display: grid; gap: 32px;">
    <p class="pt-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="pt-serif" style="max-width: 900px; margin: 0; font-size: clamp(56px, 9vw, 120px); line-height: .92;">
      {{ section.settings.heading }}
    </h1>
    <p style="max-width: 560px; color: var(--pt-muted); font-size: 18px; line-height: 1.7;">
      {{ section.settings.text }}
    </p>
    {% if section.settings.button_label != blank %}
      <a class="pt-button" href="{{ section.settings.button_url }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Practical Things"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Buy better things, keep them longer."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Durable, repairable, timeless products worth owning for decades."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
