<section style="padding: 96px 0;">
  <div class="pt-container" style="display: grid; gap: 32px;">
    <p class="pt-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="pt-serif" style="max-width: 900px; margin: 0; font-size: clamp(56px, 9vw, 120px); line-height: .92;">
      {{ section.settings.heading }}
    </h1>
    <p style="max-width: 560px; color: var(--pt-muted); font-size: 18px; line-height: 1.7;">
      {{ section.settings.text }}
    </p>
    {% if section.settings.button_label != blank or section.settings.secondary_button_label != blank %}
      <div style="display: flex; flex-wrap: wrap; gap: 12px;">
        {% if section.settings.button_label != blank %}
          <a class="pt-button" href="{{ section.settings.button_url }}">{{ section.settings.button_label }}</a>
        {% endif %}
        {% if section.settings.secondary_button_label != blank %}
          <a class="pt-button pt-button--secondary" href="{{ section.settings.secondary_button_url }}">{{ section.settings.secondary_button_label }}</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Practical Things"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stop Buying Things Twice."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The world's most trusted collection of products built to last."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Learn Our Philosophy"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Secondary button URL"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
