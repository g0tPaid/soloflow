<section style="background: var(--pt-text); color: var(--pt-background); padding: 96px 0;">
  <div class="pt-container" style="display: grid; gap: 40px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); align-items: end;">
    <div>
      <p class="pt-eyebrow" style="color: rgba(250,250,248,.65);">{{ section.settings.eyebrow }}</p>
      <h2 class="pt-serif" style="margin: 16px 0 0; font-size: clamp(44px, 7vw, 84px); line-height: 1;">
        {{ section.settings.heading }}
      </h2>
    </div>
    <div style="color: rgba(250,250,248,.76); line-height: 1.8;">
      {{ section.settings.text }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Practical Things exists",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why we exist"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Replacement should not be the default."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We believe the most practical purchase is the one that works beautifully, can be repaired, and earns its place year after year.</p>"
    }
  ],
  "presets": [
    {
      "name": "Why Practical Things exists"
    }
  ]
}
{% endschema %}
