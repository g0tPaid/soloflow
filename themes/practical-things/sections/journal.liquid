<section style="padding: 80px 0;">
  <div class="pt-container">
    <p class="pt-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="pt-serif" style="margin: 12px 0 32px; font-size: 56px;">{{ section.settings.heading }}</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 28px;">
      {% assign selected_blog = blogs[section.settings.blog] %}
      {% for article in selected_blog.articles limit: section.settings.article_limit %}
        <a href="{{ article.url }}" style="display: block;">
          {% if article.image %}
            {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy' }}
          {% endif %}
          <p class="pt-eyebrow" style="margin-top: 18px;">{{ article.published_at | date: '%B %d, %Y' }}</p>
          <h3 class="pt-serif" style="font-size: 32px;">{{ article.title }}</h3>
          <p style="color: var(--pt-muted); line-height: 1.7;">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
        </a>
      {% else %}
        <p style="color: var(--pt-muted);">Select a blog to feature Practical Things journal entries.</p>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Journal",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Read slowly"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "article_limit",
      "label": "Article limit",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Journal"
    }
  ]
}
{% endschema %}
