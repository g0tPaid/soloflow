<section class="pt-rule" style="padding: 80px 0;">
  <div class="pt-container">
    <p class="pt-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="pt-serif" style="margin: 12px 0 32px; font-size: 56px;">{{ section.settings.heading }}</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 28px;">
      {% for product in section.settings.products %}
        {% render 'product-card', product: product %}
      {% else %}
        <p style="color: var(--pt-muted);">Choose featured products in the theme editor.</p>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Curated"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for long ownership"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products"
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
