<section style="padding: 48px 0 24px;">
  <div class="pt-container">
    <p class="pt-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="pt-serif" style="margin: 12px 0; font-size: 56px;">
      {% if collection %}{{ collection.title }}{% else %}{{ section.settings.heading }}{% endif %}
    </h1>
    <p style="max-width: 680px; color: var(--pt-muted); line-height: 1.7;">
      {{ collection.description | strip_html | default: section.settings.text }}
    </p>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-top: 32px;">
      {% for block in section.blocks %}
        <div {{ block.shopify_attributes }} style="border: 1px solid var(--pt-border); background: var(--pt-card); padding: 16px;">
          <p class="pt-eyebrow">{{ block.settings.label }}</p>
          <p style="color: var(--pt-muted); line-height: 1.6;">{{ block.settings.help_text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection filters",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Fallback heading",
      "default": "Durable products"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Fallback text",
      "default": "Filter by the Practical Things standards. Wire these stubs to product tags or metafields before launch."
    }
  ],
  "blocks": [
    {
      "type": "lifespan",
      "name": "Lifespan filter",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Lifespan"
        },
        {
          "type": "text",
          "id": "help_text",
          "label": "Help text",
          "default": "Example: 10+ years, 25+ years, lifetime."
        }
      ]
    },
    {
      "type": "repairability",
      "name": "Repairability filter",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Repairability"
        },
        {
          "type": "text",
          "id": "help_text",
          "label": "Help text",
          "default": "Example: serviceable, parts available, rebuildable."
        }
      ]
    },
    {
      "type": "warranty",
      "name": "Warranty filter",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Warranty"
        },
        {
          "type": "text",
          "id": "help_text",
          "label": "Help text",
          "default": "Example: 10 years, lifetime, repair program."
        }
      ]
    },
    {
      "type": "material",
      "name": "Material filter",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Material"
        },
        {
          "type": "text",
          "id": "help_text",
          "label": "Help text",
          "default": "Example: cast iron, full-grain leather, stainless steel."
        }
      ]
    },
    {
      "type": "country",
      "name": "Country filter",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Country"
        },
        {
          "type": "text",
          "id": "help_text",
          "label": "Help text",
          "default": "Example: USA, Japan, Germany, Italy."
        }
      ]
    },
    {
      "type": "rating",
      "name": "Rating filter",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Rating"
        },
        {
          "type": "text",
          "id": "help_text",
          "label": "Help text",
          "default": "Example: 4+ stars or editor score."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "lifespan" },
      { "type": "repairability" },
      { "type": "warranty" },
      { "type": "material" },
      { "type": "country" },
      { "type": "rating" }
    ]
  }
}
{% endschema %}
