<section style="padding: 64px 0 96px;">
  <div class="pt-container">
    <p class="pt-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="pt-serif" style="margin: 12px 0 8px; font-size: clamp(44px, 7vw, 72px);">{{ section.settings.heading }}</h1>
    <p style="max-width: 560px; color: var(--pt-muted); line-height: 1.7;">{{ section.settings.text }}</p>

    <form action="{{ routes.search_url }}" method="get" role="search" style="margin-top: 32px; display: flex; flex-wrap: wrap; gap: 12px;">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ section.settings.placeholder }}"
        aria-label="{{ section.settings.placeholder }}"
        style="flex: 1 1 240px; min-height: 48px; padding: 0 16px; border: 1px solid var(--pt-border); background: var(--pt-card); color: var(--pt-text); font: inherit;"
      >
      <input type="hidden" name="type" value="product,article,page">
      <button class="pt-button" type="submit">{{ section.settings.button_label }}</button>
    </form>

    {% if search.performed %}
      <div style="margin-top: 48px; border-top: 1px solid var(--pt-border); padding-top: 40px;">
        <p class="pt-eyebrow">
          {% if search.results_count == 0 %}
            {{ section.settings.no_results_label }}
          {% else %}
            {{ search.results_count }} {{ section.settings.results_label }}
          {% endif %}
        </p>

        {% if search.results_count == 0 %}
          <p style="margin-top: 16px; color: var(--pt-muted); line-height: 1.7;">{{ section.settings.empty_text }}</p>
        {% else %}
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 28px; margin-top: 28px;">
            {% paginate search.results by section.settings.results_per_page %}
              {% for item in search.results %}
                {% if item.object_type == 'product' %}
                  {% render 'product-card', product: item %}
                {% else %}
                  <article style="border-top: 1px solid var(--pt-border); padding-top: 20px;">
                    <p class="pt-eyebrow">{{ item.object_type }}</p>
                    <h2 class="pt-serif" style="margin: 8px 0; font-size: 28px; line-height: 1.1;">
                      <a href="{{ item.url }}">{{ item.title }}</a>
                    </h2>
                    {% if item.content != blank %}
                      <p style="color: var(--pt-muted); line-height: 1.7;">{{ item.content | strip_html | truncate: 140 }}</p>
                    {% endif %}
                  </article>
                {% endif %}
              {% endfor %}

              {% if paginate.pages > 1 %}
                <nav style="grid-column: 1 / -1; display: flex; gap: 16px; margin-top: 16px;" aria-label="Search pagination">
                  {% if paginate.previous %}
                    <a href="{{ paginate.previous.url }}">Previous</a>
                  {% endif %}
                  <span style="color: var(--pt-muted);">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
                  {% if paginate.next %}
                    <a href="{{ paginate.next.url }}">Next</a>
                  {% endif %}
                </nav>
              {% endif %}
            {% endpaginate %}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find fewer, better things."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Search the catalog for durable products, guides, and long-term ownership notes."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Search placeholder",
      "default": "Search products and journal"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "results_label",
      "label": "Results label",
      "default": "results"
    },
    {
      "type": "text",
      "id": "no_results_label",
      "label": "No results label",
      "default": "No results"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Empty results text",
      "default": "Nothing matched. Try a broader term, or browse the collection by lifespan and repairability."
    },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Results per page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12
    }
  ]
}
{% endschema %}
