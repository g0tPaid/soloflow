<footer class="pt-rule" style="margin-top: 96px;">
  <div class="pt-container" style="display: grid; gap: 48px; padding: 64px 0;">
    <div>
      <p class="pt-serif" style="margin: 0; font-size: 36px;">{{ shop.name }}</p>
      <p style="max-width: 360px; color: var(--pt-muted); line-height: 1.7;">
        {{ section.settings.tagline }}
      </p>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 32px;">
      {% for block in section.blocks %}
        <div {{ block.shopify_attributes }}>
          <p class="pt-eyebrow">{{ block.settings.heading }}</p>
          <div style="display: grid; gap: 12px; margin-top: 18px;">
            {% for link in block.settings.menu.links %}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
  <div class="pt-container pt-rule" style="padding: 24px 0; color: var(--pt-muted); font-size: 12px;">
    &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Buy less. Repair more. Keep what works.
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Buy better things, keep them longer."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Explore"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "menu"
      }
    ]
  }
}
{% endschema %}
