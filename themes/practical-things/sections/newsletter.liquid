<section class="pt-rule" style="background: var(--pt-card); padding: 72px 0;">
  <div class="pt-container" style="display: grid; gap: 28px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); align-items: center;">
    <div>
      <p class="pt-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="pt-serif" style="margin: 12px 0 0; font-size: 48px;">{{ section.settings.heading }}</h2>
      <p style="color: var(--pt-muted); line-height: 1.7;">{{ section.settings.text }}</p>
    </div>
    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div style="display: flex; gap: 8px;">
        <input
          type="email"
          name="contact[email]"
          aria-label="{{ 'sections.newsletter.email' | t }}"
          placeholder="{{ 'sections.newsletter.email' | t }}"
          required
          style="min-height: 48px; flex: 1; border: 1px solid var(--pt-border); background: var(--pt-background); padding: 0 14px;"
        >
        <button class="pt-button" type="submit">{{ section.settings.button_label }}</button>
      </div>
      {% if form.posted_successfully? %}
        <p style="color: var(--pt-accent);">{{ 'sections.newsletter.success' | t }}</p>
      {% endif %}
      {{ form.errors | default_errors }}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Newsletter"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Own less. Own better."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Join the Practical Things list for guides, repair notes, and durable product research."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
