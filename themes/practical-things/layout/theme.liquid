<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    {% render 'meta-tags' %}
    {{ content_for_header }}
    <style>
      :root {
        --pt-background: {{ settings.color_background | default: '#FAFAF8' }};
        --pt-card: {{ settings.color_card | default: '#FFFFFF' }};
        --pt-text: {{ settings.color_text | default: '#111111' }};
        --pt-muted: {{ settings.color_muted | default: '#666666' }};
        --pt-accent: {{ settings.color_accent | default: '#245C4A' }};
        --pt-border: {{ settings.color_border | default: '#E8E8E8' }};
        --pt-heading-font: "Cormorant Garamond", Georgia, serif;
        --pt-body-font: Inter, ui-sans-serif, system-ui, sans-serif;
      }
      body {
        margin: 0;
        background: var(--pt-background);
        color: var(--pt-text);
        font-family: var(--pt-body-font);
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; height: auto; display: block; }
      .pt-container { width: min(1200px, calc(100% - 2rem)); margin-inline: auto; }
      .pt-serif { font-family: var(--pt-heading-font); font-weight: 500; letter-spacing: -0.02em; }
      .pt-eyebrow { color: var(--pt-muted); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; }
      .pt-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 28px;
        background: var(--pt-text);
        color: var(--pt-background);
        font-size: 13px;
        font-weight: 600;
        border: 1px solid var(--pt-text);
        cursor: pointer;
      }
      .pt-button--secondary {
        background: transparent;
        color: var(--pt-text);
      }
      .pt-rule { border-top: 1px solid var(--pt-border); }
    </style>
  </head>
  <body>
    {% section 'header' %}
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
  </body>
</html>
