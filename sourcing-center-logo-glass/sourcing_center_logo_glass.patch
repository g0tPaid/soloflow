   size = 40,
@@ -12,14 +12,19 @@ export function SevenColorMark({
   title?: string;
 }) {
   return (
-    <Image
-      src="/seven-color-mark-clear.png"
-      alt={title}
-      width={size}
-      height={size}
-      className={cn("shrink-0 bg-transparent object-contain", className)}
-      priority
-      unoptimized
-    />
+    <span
+      className={cn("logo-glass relative inline-flex shrink-0 items-center justify-center", className)}
+      style={{ width: size, height: size }}
+    >
+      <Image
+        src="/seven-color-mark-clear.png"
+        alt={title}
+        width={size}
+        height={size}
+        className="relative z-[1] h-[78%] w-[78%] object-contain"
+        priority
+        unoptimized
+      />
+    </span>
   );
 }
