From: Cursor Agent <cursoragent@cursor.com>
Date: Fri, 11 Sep 2026 03:29:14 +0000
Subject: [PATCH] Replace the black Seven Color mark with Apple-style glass.

Keep the red 7 glyph, drop the black tile, and show a frosted glass plate behind the logo only.
---
 public/seven-color-badge.svg              | 17 ++++++++-
 src/app/globals.css                       | 36 ++++++++++++++++++
 src/components/brand/seven-color-mark.tsx | 25 +++++++-----
 src/components/brand/sourcing-logo.tsx    | 46 +++++++++++------------
 4 files changed, 89 insertions(+), 35 deletions(-)

diff --git a/public/seven-color-badge.svg b/public/seven-color-badge.svg
index dcd3558..c975087 100644
--- a/public/seven-color-badge.svg
+++ b/public/seven-color-badge.svg
@@ -1,4 +1,17 @@
 <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" role="img" aria-label="Seven Color">
-  <rect width="100" height="100" rx="12" fill="#0A0A0A"/>
-  <image href="/seven-color-mark-clear.png" x="18" y="12" width="64" height="76" preserveAspectRatio="xMidYMid meet"/>
+  <defs>
+    <linearGradient id="logoGlass" x1="18%" y1="0%" x2="82%" y2="100%">
+      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.92"/>
+      <stop offset="48%" stop-color="#eef5fc" stop-opacity="0.55"/>
+      <stop offset="100%" stop-color="#c4d8ec" stop-opacity="0.42"/>
+    </linearGradient>
+    <radialGradient id="logoSheen" cx="22%" cy="12%" r="70%">
+      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.7"/>
+      <stop offset="55%" stop-color="#ffffff" stop-opacity="0"/>
+    </radialGradient>
+  </defs>
+  <rect width="100" height="100" rx="22" fill="url(#logoGlass)"/>
+  <rect width="100" height="100" rx="22" fill="url(#logoSheen)"/>
+  <rect width="99" height="99" x="0.5" y="0.5" rx="22" fill="none" stroke="#ffffff" stroke-opacity="0.62"/>
+  <image href="/seven-color-mark-clear.png" x="14" y="10" width="72" height="80" preserveAspectRatio="xMidYMid meet"/>
 </svg>
diff --git a/src/app/globals.css b/src/app/globals.css
index 58a6f14..533c136 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -119,6 +119,42 @@ body {
   }
 }
 
+.logo-glass {
+  border-radius: 22%;
+  background:
+    radial-gradient(120% 80% at 18% 8%, rgba(255, 255, 255, 0.92), transparent 52%),
+    radial-gradient(90% 70% at 82% 100%, rgba(186, 214, 240, 0.42), transparent 55%),
+    linear-gradient(165deg, rgba(255, 255, 255, 0.78) 0%, rgba(236, 244, 252, 0.4) 48%, rgba(196, 216, 236, 0.34) 100%);
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.86),
+    inset 0 -10px 18px rgba(120, 152, 186, 0.14),
+    0 10px 24px rgba(15, 23, 42, 0.12);
+  border: 0.5px solid rgba(255, 255, 255, 0.62);
+  backdrop-filter: blur(18px) saturate(1.7);
+  -webkit-backdrop-filter: blur(18px) saturate(1.7);
+}
+
+.logo-glass::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  border-radius: inherit;
+  background: linear-gradient(135deg, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0.04) 42%, transparent 62%);
+  pointer-events: none;
+}
+
+.dark .logo-glass {
+  background:
+    radial-gradient(120% 80% at 18% 8%, rgba(255, 255, 255, 0.22), transparent 52%),
+    radial-gradient(90% 70% at 82% 100%, rgba(80, 140, 200, 0.22), transparent 55%),
+    linear-gradient(165deg, rgba(255, 255, 255, 0.16) 0%, rgba(148, 176, 210, 0.12) 48%, rgba(40, 60, 90, 0.28) 100%);
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.28),
+    inset 0 -10px 18px rgba(0, 0, 0, 0.28),
+    0 10px 24px rgba(0, 0, 0, 0.35);
+  border-color: rgba(255, 255, 255, 0.22);
+}
+
 .glass {
   background: color-mix(in oklab, var(--paper-elevated) 72%, transparent);
   backdrop-filter: blur(18px) saturate(1.2);
