# Copy these onto the Railway **web** service after merge.
# Full checklist: docs/RAILWAY-MULTIUSER.md
# Redeploy web after changing any NEXT_PUBLIC_* variable (baked in at build).

NODE_ENV=production
AUTH_SECRET=replace-with-long-random-string
AUTH_URL=https://soloflow.practicalthings.store
API_URL=https://YOUR-API.up.railway.app
NEXT_PUBLIC_API_URL=https://YOUR-API.up.railway.app/api/v1
DATABASE_URL=${{Postgres.DATABASE_URL}}
NEXT_PUBLIC_LOCAL_MODE=false

# REMOVE if present: NEXT_PUBLIC_LOCAL_MODE=true
