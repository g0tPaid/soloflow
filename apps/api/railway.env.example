# Copy these onto the Railway **api** service after merge.
# Full checklist: docs/RAILWAY-MULTIUSER.md

NODE_ENV=production
PORT=3001
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://soloflow.practicalthings.store
APP_URL=https://soloflow.practicalthings.store
WEB_URL=https://soloflow.practicalthings.store
API_URL=https://YOUR-API.up.railway.app
STORAGE_PROVIDER=local
LOCAL_SINGLE_USER=false

# Optional invite / password-reset email
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=SoloFlow <noreply@yourdomain.com>

# REMOVE if present: LOCAL_USER_EMAIL, LOCAL_USER_NAME, LOCAL_USER_PASSWORD
